{
  "name": "error-strict_item_invalid",
  "description": "?strict=true refuses the whole batch on the first invalid item.",
  "request": {
    "method": "POST",
    "path": "/api/v1/batch?strict=true",
    "headers": {
      "authorization": "Bearer cks_live_example",
      "content-type": "application/json",
      "user-agent": "clickclacks-node/1.0.0"
    },
    "body": {
      "items": [
        {
          "event": "Invoice paid",
          "distinct_id": "user_8412",
          "insert_id": "inv_2291_abc",
          "properties": {
            "amount_cents": 4900
          }
        },
        {
          "event": "Invoice paid"
        }
      ]
    }
  },
  "response": {
    "status": 400,
    "headers": {
      "ratelimit-policy": "1000;w=1, 5000;w=10"
    },
    "body": {
      "error": {
        "code": "strict_item_invalid",
        "message": "strict=true refuses the whole batch when any item is invalid; nothing was stored.",
        "docs_url": "https://app.clickclacks.io/docs/api#strict_item_invalid",
        "request_id": "8c1f2d3e4f5a6b7c-FRA"
      },
      "errors": [
        {
          "index": 1,
          "code": "missing_identity",
          "field": "distinct_id",
          "message": "Send distinct_id, anonymous_id or both."
        }
      ]
    }
  }
}
